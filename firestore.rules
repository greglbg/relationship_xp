rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    match /couples/{coupleId} {
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.memberIds
                    && request.resource.data.memberIds.size() == 1;

      allow read: if request.auth != null
                  && request.auth.uid in resource.data.memberIds;

      allow update: if request.auth != null
                    && (
                      request.auth.uid in resource.data.memberIds
                      ||
                      (
                        resource.data.memberIds.size() == 1
                        && request.resource.data.memberIds.size() == 2
                        && request.resource.data.memberIds.hasAll(
                          resource.data.memberIds
                        )
                        && request.auth.uid in request.resource.data.memberIds
                        && request.resource.data
                            .diff(resource.data)
                            .affectedKeys()
                            .hasOnly(['memberIds'])
                      )
                    );

      allow delete: if false;

      match /claims/{claimId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(
                      /databases/$(database)/documents/couples/$(coupleId)
                    ).data.memberIds;

        allow create: if request.auth != null
                      && request.auth.uid in get(
                        /databases/$(database)/documents/couples/$(coupleId)
                      ).data.memberIds
                      && request.resource.data.submittedByUserId
                         == request.auth.uid
                      && request.resource.data.status == 'pending'
                      && request.resource.data.title is string
                      && request.resource.data.title.size() > 0
                      && request.resource.data.title.size() <= 100
                      && request.resource.data.xp is int
                      && request.resource.data.xp > 0
                      && request.resource.data.xp <= 100
                      && request.resource.data.keys().hasOnly([
                        'title',
                        'xp',
                        'submittedByUserId',
                        'status',
                        'photoPath',
                        'photoUrl',
                        'createdAt'
                      ])
                      && (
                        (
                          !('photoPath' in request.resource.data)
                          && !('photoUrl' in request.resource.data)
                        )
                        ||
                        (
                          request.resource.data.photoPath is string
                          && request.resource.data.photoPath.size() > 0
                          && request.resource.data.photoUrl is string
                          && request.resource.data.photoUrl.size() > 0
                        )
                      );

        allow update: if request.auth != null
                      && request.auth.uid in get(
                        /databases/$(database)/documents/couples/$(coupleId)
                      ).data.memberIds
                      && (
                        isPartnerReview()
                        ||
                        isClaimResubmission()
                      );

        allow delete: if false;

        function isPartnerReview() {
          return request.auth.uid != resource.data.submittedByUserId
                 && resource.data.status == 'pending'
                 && request.resource.data.reviewedByUserId
                    == request.auth.uid
                 && (
                   (
                     request.resource.data.status == 'approved'
                     && request.resource.data
                         .diff(resource.data)
                         .affectedKeys()
                         .hasOnly([
                           'status',
                           'reviewedByUserId',
                           'reviewedAt'
                         ])
                   )
                   ||
                   (
                     request.resource.data.status == 'changes_requested'
                     && request.resource.data.reviewMessage is string
                     && request.resource.data.reviewMessage.size() > 0
                     && request.resource.data.reviewMessage.size() <= 300
                     && request.resource.data
                         .diff(resource.data)
                         .affectedKeys()
                         .hasOnly([
                           'status',
                           'reviewMessage',
                           'reviewedByUserId',
                           'reviewedAt'
                         ])
                   )
                 );
        }

        function isClaimResubmission() {
          return request.auth.uid == resource.data.submittedByUserId
                 && resource.data.status == 'changes_requested'
                 && request.resource.data.status == 'pending'
                 && request.resource.data.submittedByUserId
                    == resource.data.submittedByUserId
                 && request.resource.data
                     .diff(resource.data)
                     .affectedKeys()
                     .hasOnly([
                       'title',
                       'xp',
                       'status',
                       'photoPath',
                       'photoUrl',
                       'resubmittedAt',
                       'reviewMessage',
                       'reviewedByUserId',
                       'reviewedAt'
                     ]);
        }
      }

      match /awards/{awardId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(
                      /databases/$(database)/documents/couples/$(coupleId)
                    ).data.memberIds;

        allow create, update, delete: if false;
      }
    }

    match /coupleInvites/{inviteCode} {
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid
                    && exists(
                      /databases/$(database)/documents/couples/$(request.resource.data.coupleId)
                    )
                    && request.auth.uid in get(
                      /databases/$(database)/documents/couples/$(request.resource.data.coupleId)
                    ).data.memberIds;

      allow get: if request.auth != null;

      allow list: if false;

      allow update, delete: if request.auth != null
                            && resource.data.createdBy == request.auth.uid;
    }
  }
}