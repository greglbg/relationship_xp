rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    match /couples/{coupleId} {
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.memberIds
                    && request.resource.data.memberIds.size() == 1;

      allow read: if isExistingCoupleMember();

      allow update: if isCoupleJoin()
                    || isMemberNameUpdate();

      allow delete: if false;

      function isExistingCoupleMember() {
        return request.auth != null
               && request.auth.uid in resource.data.memberIds;
      }

      function isCoupleJoin() {
        return request.auth != null
               && resource.data.memberIds.size() == 1
               && request.resource.data.memberIds.size() == 2
               && request.resource.data.memberIds.hasAll(
                 resource.data.memberIds
               )
               && request.auth.uid in request.resource.data.memberIds
               && !(request.auth.uid in resource.data.memberIds)
               && request.resource.data
                   .diff(resource.data)
                   .affectedKeys()
                   .hasOnly([
                     'memberIds'
                   ]);
      }

      function isMemberNameUpdate() {
        return request.auth != null
               && request.auth.uid in resource.data.memberIds
               && request.resource.data
                   .diff(resource.data)
                   .affectedKeys()
                   .hasOnly([
                     'memberNames'
                   ])
               && request.resource.data.memberNames is map
               && request.resource.data.memberNames
                   .diff(resource.data.get('memberNames', {}))
                   .affectedKeys()
                   .hasOnly([
                     request.auth.uid
                   ])
               && request.resource.data.memberNames[
                    request.auth.uid
                  ] is string
               && request.resource.data.memberNames[
                    request.auth.uid
                  ].size() > 0
               && request.resource.data.memberNames[
                    request.auth.uid
                  ].size() <= 50;
      }

      match /claims/{claimId} {
        allow read: if isCoupleMember(coupleId);

        allow create: if isCoupleMember(coupleId)
                      && request.resource.data.submittedByUserId
                         == request.auth.uid
                      && request.resource.data.status == 'pending'
                      && request.resource.data.title is string
                      && request.resource.data.title.size() > 0
                      && request.resource.data.title.size() <= 100
                      && request.resource.data.xp == 25
                      && request.resource.data.keys().hasOnly([
                        'title',
                        'xp',
                        'submittedByUserId',
                        'status',
                        'photoPath',
                        'photoUrl',
                        'createdAt'
                      ])
                      && hasValidOptionalPhoto(
                        request.resource.data
                      );

        allow update: if isCoupleMember(coupleId)
                      && (
                        isPartnerReview()
                        || isClaimResubmission()
                      );

        allow delete: if false;

        function isPartnerReview() {
          return request.auth.uid != resource.data.submittedByUserId
                 && resource.data.status == 'pending'
                 && request.resource.data.submittedByUserId
                    == resource.data.submittedByUserId
                 && request.resource.data.reviewedByUserId
                    == request.auth.uid
                 && (
                   (
                     request.resource.data.status == 'approved'
                     && request.resource.data
                         .diff(resource.data)
                         .affectedKeys()
                         .hasOnly([
                           'status',
                           'reviewedByUserId',
                           'reviewedAt'
                         ])
                   )
                   ||
                   (
                     request.resource.data.status
                        == 'changes_requested'
                     && request.resource.data.reviewMessage
                        is string
                     && request.resource.data.reviewMessage.size()
                        > 0
                     && request.resource.data.reviewMessage.size()
                        <= 300
                     && request.resource.data
                         .diff(resource.data)
                         .affectedKeys()
                         .hasOnly([
                           'status',
                           'reviewMessage',
                           'reviewedByUserId',
                           'reviewedAt'
                         ])
                   )
                 );
        }

        function isClaimResubmission() {
          return request.auth.uid
                    == resource.data.submittedByUserId
                 && resource.data.status == 'changes_requested'
                 && request.resource.data.status == 'pending'
                 && request.resource.data.submittedByUserId
                    == resource.data.submittedByUserId
                 && request.resource.data.title is string
                 && request.resource.data.title.size() > 0
                 && request.resource.data.title.size() <= 100
                 && request.resource.data.xp == 25
                 && hasValidOptionalPhoto(
                      request.resource.data
                    )
                 && request.resource.data
                     .diff(resource.data)
                     .affectedKeys()
                     .hasOnly([
                       'title',
                       'xp',
                       'status',
                       'photoPath',
                       'photoUrl',
                       'resubmittedAt',
                       'reviewMessage',
                       'reviewedByUserId',
                       'reviewedAt'
                     ]);
        }
      }

      match /awards/{awardId} {
        allow read: if isCoupleMember(coupleId);

        allow create, update, delete: if false;
      }

      match /catalogXpDays/{dayId} {
        allow read, write: if false;
      }

      match /catalogTaskPeriods/{counterId} {
        allow read, write: if false;
      }
    }

    match /coupleInvites/{inviteCode} {
      allow create: if request.auth != null
                    && request.resource.data.createdBy
                       == request.auth.uid
                    && exists(
                      /databases/$(database)/documents/couples/$(request.resource.data.coupleId)
                    )
                    && request.auth.uid in get(
                      /databases/$(database)/documents/couples/$(request.resource.data.coupleId)
                    ).data.memberIds;

      allow get: if request.auth != null;

      allow list: if false;

      allow update, delete: if request.auth != null
                            && resource.data.createdBy
                               == request.auth.uid;
    }

    function isCoupleMember(coupleId) {
      return request.auth != null
             && request.auth.uid in get(
               /databases/$(database)/documents/couples/$(coupleId)
             ).data.memberIds;
    }

    function hasValidOptionalPhoto(data) {
      return (
        !data.keys().hasAny([
          'photoPath',
          'photoUrl'
        ])
        ||
        (
          data.keys().hasAll([
            'photoPath'
          ])
          && data.photoPath is string
          && data.photoPath.size() > 0
          && (
            !data.keys().hasAny([
              'photoUrl'
            ])
            ||
            (
              data.photoUrl is string
              && data.photoUrl.size() > 0
            )
          )
        )
      );
    }
  }
}